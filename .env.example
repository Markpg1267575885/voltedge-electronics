# Copy this file to .env and fill in your own values.
# Get these from https://developer.safaricom.co.ke after creating an app
# under "My Apps" (Lipa Na M-Pesa Online / STK Push sandbox).

# App credentials (Daraja > My Apps > your app)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Sandbox shortcode + passkey — these two are Safaricom's published
# sandbox test values and work for everyone in the sandbox environment.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# "sandbox" while testing, "production" once Safaricom approves you and
# gives you a live shortcode + passkey
MPESA_ENV=sandbox

# Public HTTPS URL Safaricom will call with the payment result.
# Your machine isn't reachable from the internet by default — while
# developing, run `ngrok http 4000` and paste the https URL it gives you
# here, e.g. https://a1b2c3d4.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-public-url/api/mpesa/callback

PORT=4000
